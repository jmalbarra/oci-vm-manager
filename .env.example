# ===========================================
# OCI VM Manager — Config
# Copiá esto a .env y editá lo que necesites
# ===========================================

# 🔐 Admin (para entrar al panel)
ADMIN_EMAIL=tu-email@ejemplo.com
# Generar hash: node -e "console.log(require('bcryptjs').hashSync('tu-pass', 10))"
ADMIN_PASSWORD_HASH=

# 🍪 Sesión (inventá cualquier string largo y random)
SESSION_SECRET=generar-un-secret-aleatorio-aqui

# 🖥️ OCI VM (para desplegar Caddy)
OCI_HOST=IP_DEL_SERVIDOR
OCI_USER=ubuntu
# Path a tu llave SSH (o usá OCI_SSH_PRIVATE_KEY con el contenido)
OCI_SSH_KEY_PATH=~/.ssh/id_ed25519

# Puerto (opcional, default 3080)
# PORT=3080
