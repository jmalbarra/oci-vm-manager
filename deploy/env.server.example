# Copiar a /opt/oci-vm-manager/.env en el servidor
# OCI_HOST=127.0.0.1 porque la app corre en el mismo servidor que administra
# OCI_PUBLIC_IP=137.x.x.x  (opcional: para que "Verificar" use localhost directo y muestre verde)
NODE_ENV=production
ADMIN_EMAIL=tu-email@ejemplo.com
# Generar: node -e "console.log(require('bcryptjs').hashSync('tu-pass', 10))"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=cambiar-por-algo-random-min-32-chars
FORCE_SECURE_COOKIE=1
OCI_HOST=127.0.0.1
OCI_USER=ubuntu
OCI_SSH_KEY_PATH=/home/ubuntu/.ssh/id_ed25519
